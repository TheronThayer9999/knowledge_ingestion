{
  "app": {
    "name": "manager_docker_compose",
    "port": 9001,
    "env": "development"
  },
  "database": {
    "host": "127.0.0.1",
    "port": 5432,
    "user": "theron_user",
    "password": "theron_db_pass",
    "dbname": "manager_db",
    "sslmode": "disable"
  },
  "storage": {
    "type": "seaweedfs",
    "s3_endpoint": "http://localhost:8333",
    "access_key": "theron_access_key",
    "secret_key": "theron_secret_key_123",
    "bucket_name": "app-uploads"
  },
  "qdrant": {
    "host": "127.0.0.1",
    "port": 6333,
    "grpc_port": 6334,
    "token": "theron_qdrant_token",
    "scheme": "http",
    "quantization": "scalar",
    "on_disk_vectors": true,
    "on_disk_payload": true,
    "rescore": true,
    "oversampling": 2.0,
    "principal_index": true
  },
  "embedding": {
    "provider": "ollama",
    "model": "bge-m3:latest",
    "base_url": "http://localhost:11434/",
    "api_key": "",
    "dim": 1024
  },
  "llms": {
    "default_provider": "ollama",
    "providers": {
      "ollama": {
        "type": "ollama",
        "model": "gemma4:31b",
        "base_url": "https://ollama.com",
        "api_key": "",
        "temperature": 0,
        "max_tokens": 4096,
        "timeout_sec": 120
      },
      "openrouter": {
        "type": "openai",
        "model": "apodex/apodex-1.1-mini:free",
        "base_url": "https://openrouter.ai/api/v1",
        "api_key": "",
        "temperature": 0,
        "max_tokens": 4096,
        "timeout_sec": 120
      },
      "groq": {
        "type": "openai",
        "model": "qwen/qwen3.8-27b",
        "base_url": "https://api.groq.com/openai/v1",
        "api_key": "",
        "temperature": 0.6,
        "top_p": 0.95,
        "max_tokens": 4096,
        "timeout_sec": 120,
        "rate_limit_rpm": 30
      },
      "9router": {
        "type": "openai",
        "model": "kc/nvidia/nemotron-3-ultra-550b-a55b:free",
        "base_url": "http://localhost:20128/v1",
        "api_key": "",
        "temperature": 0,
        "max_tokens": 4096,
        "timeout_sec": 300
      },
      "nvidia": {
        "type": "openai",
        "model": "meta/muse-glimmer-30b",
        "base_url": "https://integrate.api.nvidia.com/v1",
        "api_key": "",
        "temperature": 0,
        "max_tokens": 4096,
        "timeout_sec": 300
      }
    }
  },
  "ocr": {
    "enabled": true,
    "binary": "C:\\Program Files\\Tesseract-OCR\\tesseract.exe",
    "lang": "vie+eng",
    "timeout_sec": 120,
    "min_text_chars": 0,
    "psm": 6,
    "render_binary": "D:\\code\\tools\\poppler\\poppler-24.08.0\\Library\\bin\\pdftoppm.exe",
    "render_dpi": 300
  },
  "redis": {
    "host": "127.0.0.1",
    "port": 6379,
    "db": 0,
    "password": "",
    "socket_timeout": 5,
    "retry_on_timeout": true
  },
  "rabbitmq": {
    "host": "127.0.0.1",
    "port": 5672,
    "user": "admin",
    "password": "admin123",
    "vhost": "/",
    "exchange": "knowledge.events",
    "queue": "knowledge.outbox"
  },
  "jwt": {
    "secret": "dev-only-change-me-via-JWT_SECRET-env",
    "expiry_minutes": 1440,
    "refresh_expiry_days": 30,
    "refresh_absolute_days": 90
  },
  "cors": {
    "allowed_origins": ["http://localhost:4200", "http://127.0.0.1:4200"]
  },
  "worker": {
    "trim_interval_hours": 24,
    "chunker": "recursive",
    "layout_detector": false
  },
  "vlm": {
    "enabled": false,
    "base_url": "http://localhost:11434",
    "model": "qwen2.5vl:7b",
    "api_key": "",
    "timeout_sec": 180,
    "max_tokens": 2048,
    "temperature": 0,
    "max_image_bytes": 10485760
  }
}